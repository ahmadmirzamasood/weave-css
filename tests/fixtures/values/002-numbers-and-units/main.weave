rule .n {
    --max: #{1000000000000};
    --min: #{-1000000000000};
    --tiny: #{0.0000004};
    --round: #{0.0000015};
    --rad: #{180deg + 0rad};
    --pt: #{72pt == 1in};
    --q: #{40Q + 0mm};
    --mm: #{10mm + 1cm};
    --pct: #{50% * 2};
    --div: #{10px / 4};
    --ratio: #{3px / 2px};
    --cmp: #{1cm < 1in};
    --str-cmp: #{"a" < "b"};
    --unknown: #{2foo + 3FOO};
    --neg: #{-(2px - 5px)};
    --mixed-eq: #{1px == 1em};
    --list-eq: #{[1, "a"] == [1, "a"]};
    --map-eq: #{{a: 1, b: 2} == {b: 2, a: 1}};
}
