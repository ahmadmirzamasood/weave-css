---
import Base from '../../layouts/Base.astro';
import { posts } from '../../data/posts.mjs';
---

<Base title="Blog | Weave" description="Release announcements and news about Weave.">
  <main id="main">
    <div class="page-head">
      <div class="wrap">
        <p class="eyebrow">News</p>
        <h1>Blog</h1>
        <p class="intro">Release announcements and project news.</p>
      </div>
    </div>
    <div class="wrap" style="padding-top:2.5rem;max-width:52rem">
      <ul class="post-list">
        {posts.map((p) => (
          <li>
            <h2><a href={`/blog/${p.slug}/`}>{p.title}</a></h2>
            <p class="meta"><time datetime={p.date}>{p.date}</time> · {p.author}</p>
            <p>{p.summary}</p>
          </li>
        ))}
      </ul>
    </div>
  </main>
</Base>
