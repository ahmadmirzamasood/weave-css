bind zero = 0;
bind safe = false && 1 / zero == 1;
bind also = true || [][5] == 1;

rule .p {
    --a: #{2 + 3 * 4};
    --b: #{(2 + 3) * 4};
    --c: #{10 - 4 - 3};
    --d: #{12 / 3 / 2};
    --e: #{-2 * -3};
    --f: #{!false && 1 < 2 || false};
    --g: #{safe};
    --h: #{also};
    --i: #{"a" + "b" == "ab"};
    --j: #{1 + 1 == 2 && 3 > 2};
}
