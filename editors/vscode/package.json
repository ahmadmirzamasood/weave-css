{
  "name": "weave-syntax",
  "displayName": "Weave",
  "description": "Syntax highlighting for Weave (.weave) stylesheets. Not a language server.",
  "version": "0.1.0",
  "publisher": "weave-local",
  "private": true,
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/ahmadmirzamasood/weave-css.git", "directory": "editors/vscode" },
  "bugs": { "url": "https://github.com/ahmadmirzamasood/weave-css/issues" },
  "homepage": "https://github.com/ahmadmirzamasood/weave-css/tree/main/editors",
  "engines": { "vscode": "^1.75.0" },
  "categories": ["Programming Languages"],
  "keywords": ["weave", "css", "stylesheet", "preprocessor"],
  "contributes": {
    "languages": [
      {
        "id": "weave",
        "aliases": ["Weave", "weave"],
        "extensions": [".weave"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "weave",
        "scopeName": "source.weave",
        "path": "./syntaxes/weave.tmLanguage.json"
      }
    ]
  }
}
