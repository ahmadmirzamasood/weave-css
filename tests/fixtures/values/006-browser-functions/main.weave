bind gap = 8px;

rule .f {
    width: calc(100% - var(--gap, 8px));
    height: calc(100% - #{gap * 2});
    padding: env(safe-area-inset-top, #{gap});
    margin: max(gap, 2px);
    color: primary;
    inset: anchor(--a top);
    --x: my-fn(#{gap}, gap);
    content: "gap";
    transform: rotate(calc(1turn / 8));
}
