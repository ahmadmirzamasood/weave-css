rule .units {
    --a: #{1in + 1cm};
    --b: #{1cm + 1in};
    --c: #{1 / 3};
    --d: #{10px * 2};
    --e: #{2 * 1.5rem};
    --f: #{1turn / 1deg};
    --g: #{100ms + 1s};
    --h: #{7px % 3px};
    --i: #{-7 % 3};
    --j: #{0.1 + 0.2 == 0.3};
    --k: #{1in == 96px};
    --l: #{0 == 0px};
    --m: #{2px * -0};
    --n: #{1000000 * 1000};
    --o: #{10PX + 1Px};
    --p: #{2 / 3 * 3};
}
